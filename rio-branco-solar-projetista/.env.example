# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no Vercel (produção).
# Os valores abaixo são FICTÍCIOS. Nunca versione chaves reais.

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (publishable ou anon). Pode ir ao navegador: o acesso é limitado pelas políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Chave secreta (secret ou service_role). SOMENTE no servidor. Usada para a proposta pública e os scripts.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Proprietário ------------------------------------------------------------
# E-mail do único usuário com acesso ao painel (conferido no servidor a cada requisição).
OWNER_EMAIL=proprietario@exemplo.com.br

# --- Propostas ---------------------------------------------------------------
# Segredo do servidor (mínimo 32 caracteres) para PIN, sessão de desbloqueio e link.
# Gere com: openssl rand -base64 48
PROPOSTA_SEGREDO=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
# Duração do desbloqueio por PIN, em minutos (padrão 120).
PROPOSTA_SESSAO_MINUTOS=120
# Endereço público do sistema, usado para montar os links das propostas.
NEXT_PUBLIC_APP_URL=https://propostas.exemplo.com.br

# --- Identidade mostrada nas propostas ---------------------------------------
EMPRESA_NOME=Rio Branco Solar
EMPRESA_CONTATO=(68) 90000-0000 · contato@exemplo.com.br
EMPRESA_CIDADE=Rio Branco - AC

# --- Gemini (opcional) -------------------------------------------------------
# Chave da cota gratuita criada no Google AI Studio, em um projeto SEM faturamento.
# Sem a chave, o sistema funciona normalmente com o editor manual e a importação do ChatGPT.
GEMINI_API_KEY=
# Modelo com entrada de imagem disponível na cota gratuita (conferido na documentação em 14/11/2026).
GEMINI_MODEL=gemini-3.8-flash
